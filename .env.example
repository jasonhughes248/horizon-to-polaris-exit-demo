# Copy to .env and fill in. .env is gitignored; never commit real values.

# ── Snowflake ────────────────────────────────────────────────────────────────
# Named connection in ~/.snowflake/config.toml (or connections.toml) for an
# admin user that can use ACCOUNTADMIN. Only setup/ and the cutover steps use it.
SNOWFLAKE_CONNECTION_NAME=
# Account URL used for the Horizon Iceberg REST endpoint, e.g.
# https://<orgname>-<accountname>.snowflakecomputing.com
SNOWFLAKE_ACCOUNT_URL=

SF_DATABASE=HORIZON_EXIT_DEMO_DB
SF_SCHEMA=DEMO
SF_TABLE=EVENTS
SF_WAREHOUSE=HORIZON_EXIT_DEMO_WH
SF_EXTERNAL_VOLUME=HORIZON_EXIT_DEMO_VOL
# Public IP/CIDR of the machine running Spark. Snowflake requires a network
# policy on service users before they can authenticate with a PAT.
ALLOWED_IP_CIDR=

# ── AWS ──────────────────────────────────────────────────────────────────────
# Credentials come from the standard AWS CLI chain (AWS_PROFILE, ~/.aws, SSO).
AWS_PROFILE=
AWS_REGION=us-west-2
# Dedicated bucket for this demo. Do not reuse a bucket other workloads depend
# on: the cutover step denies Snowflake's IAM role access to this bucket.
S3_BUCKET=
S3_PREFIX=horizon-to-polaris-exit
# IAM role Snowflake's external volume assumes (created by step 0, setup/run_setup.py)
SNOWFLAKE_EXTVOL_ROLE_NAME=horizon-to-polaris-exit-snowflake

# ── Polaris (written by cloud/deploy-polaris.sh) ─────────────────────────────
POLARIS_IMAGE=apache/polaris:1.8.0
POLARIS_ROOT_CREDENTIAL=
CATALOG_URI=
ECS_TASK_ROLE_ARN=
ECS_TASK_EXECUTION_ROLE_ARN=

# ── Spark ────────────────────────────────────────────────────────────────────
ICEBERG_VERSION=1.12.0
